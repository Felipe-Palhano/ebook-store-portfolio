# Mercado Pago (Developers dashboard > Your integrations)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
MP_WEBHOOK_SECRET=your-webhook-secret

# Public address of the site (for local tests, use an ngrok link)
BASE_URL=https://your-site.com

# Long random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=replace-with-a-long-random-value

# Products (files go inside the /private folder)
EBOOK_TITLE=ENEM Essay E-book
EBOOK_FILE=essay.pdf
MATH_TITLE=ENEM Math E-book
MATH_FILE=math.pdf

# Prices in BRL: one e-book / both e-books
PRICE=14.99
PRICE_BUNDLE=24.99

# Outgoing e-mail (SMTP)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASS=password
MAIL_FROM="Your Store <contact@your-site.com>"
# Receives an alert if a delivery e-mail fails (defaults to SMTP_USER)
ALERT_EMAIL=owner@your-site.com
